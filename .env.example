VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. GA4 stays off entirely (no script loaded) until this is set —
# see src/components/seo/Analytics.jsx. Get this from GA4 Admin ->
# Data Streams -> your web stream -> Measurement ID (starts with "G-").
VITE_GA_MEASUREMENT_ID=

# Optional. PostHog (page views + the waitlist funnel) stays off entirely
# until this is set, and even then only loads for a visitor who accepts
# the consent banner — see src/lib/analytics.js and ConsentBanner.jsx.
# Get this from PostHog -> Project Settings -> Project API Key.
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com if unset. Use the EU host if your
# PostHog project is EU-hosted.
VITE_POSTHOG_HOST=
